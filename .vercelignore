# Local-only tooling and scratch — must never be uploaded to Vercel.
# The bundled ffmpeg binaries alone are ~600 MB and blow past Vercel's
# 100 MB-per-file limit. The Vercel CLI uses THIS file (not .gitignore) to
# decide what to upload, so these have to be listed here explicitly.
.ffmpeg/
.demo-raw/
.demo-profile/
.demo-frames/

# Secrets and local env — .env.local holds a short-lived OIDC token.
.env*
*.local

# Logs (e.g. .pipeline.log, ~310 KB) — build noise, not deploy input.
*.log

# Version control and agent/tool scratch dirs.
.git/
.worktrees/
.vercel/
.backlog/
.llm/
.hermes/
.claude/
.atomic/
.playwright-mcp/
.playwright/
test-results/
playwright-report/
blob-report/

# Dependencies and build output — Vercel installs and builds these itself.
node_modules/
dist/
