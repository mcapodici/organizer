{
  "name": "timeline-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "kill-port 5174 5175",
    "dev": "concurrently -k -n docs,app -c blue,green \"npm:docs:dev\" \"npm:app:dev\"",
    "app:dev": "vite --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "check": "bash scripts/check.sh",
    "build": "vitest run && npm run typecheck && vitepress build docs && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs --host 0.0.0.0",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:shots": "node scripts/seed-and-shoot.mjs",
    "docs:video": "node scripts/record-demo.mjs",
    "deploy:preview": "bash scripts/deploy-preview.sh",
    "agent": "tsx .sandcastle/main.ts",
    "agent:setup": "tsx .sandcastle/main.ts --setup"
  },
  "dependencies": {
    "@tiptap/extension-code": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@vercel/analytics": "^2.0.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.15.0",
    "uuid": "^14.0.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^10.0.3",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  }
}
